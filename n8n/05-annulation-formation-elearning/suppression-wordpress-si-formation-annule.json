    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nconst identifiant =\n  String(\n    item.body?.identifiantElearning ??\n    item.identifiantElearning ??\n    \"\"\n  ).trim();\n\nconst motDePasse =\n  String(\n    item.body?.motDePasse ??\n    item.motDePasse ??\n    \"\"\n  ).trim();\n\nif (!identifiant) {\n  throw new Error(\"identifiantElearning manquant dans le webhook.\");\n}\n\n// motDePasse non obligatoire pour la suppression,\n// on le garde juste au cas où tu veux logger / vérifier plus tard\n\nreturn [\n  {\n    json: {\n      identifiant,\n      motDePasse\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        768,
        256
      ],
      "id": "434797f6-4e40-4bf0-839f-75c4f818359b",
      "name": "Code Sécurité1"
    },
    {
      "parameters": {
        "url": "=https://nouvelleecole.club/index.php/wp-json/mp/v1/members?search={{ encodeURIComponent($json.identifiant) }}&per_page=10",
