      "id": "70f6b358-c4ec-4b3e-8343-c51eb43a51bb",
      "name": "HTTP Search MemberPress1"
    },
    {
      "parameters": {
        "jsCode": "const identifiant = $('Code Sécurité1').first().json.identifiant.toLowerCase().trim();\nconst inputItems = $input.all();\nconst members = inputItems.map(item => item.json);\n\nconst exactMatches = members.filter((member) => {\n  const email = String(member.email || \"\").trim().toLowerCase();\n  const username = String(member.username || \"\").trim().toLowerCase();\n  return email === identifiant || username === identifiant;\n});\n\nif (exactMatches.length === 0) {\n  throw new Error(`Aucun membre WordPress / MemberPress trouvé pour ${identifiant}`);\n}\n\nif (exactMatches.length > 1) {\n  throw new Error(`Plusieurs membres exacts trouvés pour ${identifiant}. Arrêt de sécurité.`);\n}\n\nconst member = exactMatches[0];\n\nif (!member.id) {\n  throw new Error(\"Le membre trouvé n'a pas d'id exploitable pour la suppression.\");\n}\n\nreturn [\n  {\n    json: {\n      identifiant,\n      memberpressId: member.id,\n      memberpressEmail: member.email || \"\",\n      memberpressUsername: member.username || \"\"\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
