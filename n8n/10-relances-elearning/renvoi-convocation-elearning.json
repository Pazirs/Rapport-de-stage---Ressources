    {
      "parameters": {
        "jsCode": "const documentId = $('Copy file').first().json.id;\n\nconst loopJson = $('Loop Over Items3').item.json || {};\nconst stagiaire = loopJson.fields || loopJson || {};\n\nconst session = $('Get a record').first().json || {};\nconst dataRow = $('Get row(s)2').first().json || {};\n\n// Helper pour toujours renvoyer une string propre\nfunction toText(value) {\n  if (value === undefined || value === null) return '';\n  if (Array.isArray(value)) return value.map(v => String(v ?? '')).join('\\n');\n  return String(value);\n}\n\n// Helper pour formater une date en jj/mm/aaaa\nfunction toFrenchDate(value) {\n  if (!value) return '';\n\n  const str = String(value);\n\n  if (str.includes('T')) {\n    const [datePart] = str.split('T');\n    const [year, month, day] = datePart.split('-');\n    if (year && month && day) {\n      return `${day}/${month}/${year}`;\n    }\n  }\n\n  const parts = str.split('-');\n  if (parts.length === 3) {\n    const [year, month, day] = parts;\n    return `${day}/${month}/${year}`;\n  }\n\n  return str;\n}\n\nconst replacements = [\n  {\n    oldText: '{{Formation}}',\n    newText: toText(stagiaire.Formation),\n  },\n  {\n    oldText: '{{Periode}}',\n    newText: toText(session.Session),\n  },\n  {\n    oldText: '{{Duree_totale}}',\n    newText: toText(dataRow.Duree_totale),\n  },\n  {\n    oldText: '{{Objectifs}}',\n    newText: toText(dataRow.Objectifs),\n  },\n  {\n    oldText: '{{Numero_et_nom_RS}}',\n    newText: toText(dataRow.Numero_et_nom_RS),\n  },\n  {\n    oldText: '{{Lien_RS}}',\n    newText: toText(dataRow.Lien_RS || dataRow['Lien_RS']),\n  },\n  {\n    oldText: '{{heure_foad}}',\n    newText: toText(dataRow.Heure_foad),\n  },\n  {\n    oldText: '{{heure_synchrone}}',\n    newText: toText(dataRow.Heure_synchrone),\n  },\n  {\n    oldText: '{{Aujourd_hui}}',\n    newText: toFrenchDate(stagiaire['Date de création de la ligne']),\n  },\n  {\n    oldText: '{{Prenom}}',\n    newText: toText(stagiaire['Prénom']),\n  },\n  {\n    oldText: '{{Nom}}',\n    newText: toText(stagiaire.Nom),\n  },\n  {\n    oldText: '{{Atelier_X}}',\n    newText: toText($json.Atelier),\n  },\n  {\n    oldText: '{{Date_Heure_X}}',\n    newText: toText($json.Creneau),\n  },\n  {\n    oldText: '{{Modalite}}',\n    newText: toText($json.Modalite),\n  },\n];\n\nconst requests = replacements.map(item => ({\n  replaceAllText: {\n    containsText: {\n      text: item.oldText,\n      matchCase: true,\n    },\n    replaceText: item.newText,\n  },\n}));\n\nreturn [\n  {\n    json: {\n      documentId,\n      requests,\n    },\n  },\n];"
      },
