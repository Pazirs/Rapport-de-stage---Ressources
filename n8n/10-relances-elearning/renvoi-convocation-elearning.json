    {
      "parameters": {
        "jsCode": "// Code node n8n\n// Sortie : 1 item avec 3 variables\n// - Atelier : [\"Atelier 1\", ...]\n// - Creneau : [\"27/03/2026 de 18:00 à 19:00 ou 29/03/2026 de 16:00 à 17:00\", ...]\n// - Modalite : [\"En visioconférence\", ...]\n\nconst input = $json;\nconst certificateur = (input.Certificateur || \"\").trim();\n\nlet totalAteliers = 0;\n\nif (certificateur === \"One Learn\" || certificateur === \"Aucun\") {\n  totalAteliers = 5;\n} else if (certificateur === \"ICDL\") {\n  totalAteliers = 4;\n} else {\n  throw new Error(`Certificateur non géré : ${certificateur}`);\n}\n\nfunction addOneHour(timeStr) {\n  if (!timeStr || typeof timeStr !== \"string\") return \"\";\n\n  let [hours, minutes] = timeStr.split(\":\").map(Number);\n  hours = (hours + 1) % 24;\n\n  return `${String(hours).padStart(2, \"0\")}:${String(minutes).padStart(2, \"0\")}`;\n}\n\nfunction formatDateCreneauSansDecalage(isoString) {\n  if (!isoString || typeof isoString !== \"string\") return \"\";\n\n  const [datePart, timePartRaw] = isoString.split(\"T\");\n  if (!datePart || !timePartRaw) return isoString;\n\n  const [year, month, day] = datePart.split(\"-\");\n  const heureDebut = timePartRaw.slice(0, 5);\n  const heureFin = addOneHour(heureDebut);\n\n  return `${day}/${month}/${year} de ${heureDebut} à ${heureFin}`;\n}\n\nconst Atelier = [];\nconst Creneau = [];\nconst Modalite = [];\n\nfor (let i = 1; i <= totalAteliers; i++) {\n  const index1 = (i * 2) - 1;\n  const index2 = i * 2;\n\n  const date1 = input[`Date atelier ${index1}`];\n  const date2 = input[`Date atelier ${index2}`];\n\n  Atelier.push(`Atelier ${i}`);\n  Creneau.push(\n    `${formatDateCreneauSansDecalage(date1)} ou ${formatDateCreneauSansDecalage(date2)}`\n  );\n  Modalite.push(\"En visio\");\n}\n\nreturn [\n  {\n    json: {\n      Atelier,\n      Creneau,\n      Modalite,\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        4512
