        "jsCode": "const items = $input.all();\n\nconst apprenantsInscrits = items.flatMap(item => {\n  const data = item.json.fields || item.json || {};\n\n  return Array.isArray(data[\"Apprenants Inscrits\"])\n    ? data[\"Apprenants Inscrits\"]\n    : [];\n});\n\n// Supprime les doublons\nconst idsUniques = [...new Set(apprenantsInscrits)];\n\n// Génère une formule Airtable utilisable dans Search Records\nconst formuleSearchRecords = idsUniques.length\n  ? `OR(${idsUniques.map(id => `RECORD_ID() = \"${id}\"`).join(\", \")})`\n  : `FALSE()`;\n\nreturn [\n  {\n    json: {\n      total_apprenants: idsUniques.length,\n      ids_apprenants: idsUniques,\n      formule_search_records: formuleSearchRecords\n    }\n  }\n];"
