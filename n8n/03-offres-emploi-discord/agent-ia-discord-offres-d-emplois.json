    {
      "parameters": {
        "jsCode": "const rows = $input.all();\n\nconst row = rows.find(item => {\n  const j = item.json || {};\n  return j.rapidapi_key || j.access_token || j.api_key || j.key;\n});\n\nconst rapidapiKey =\n  row?.json?.rapidapi_key ||\n  row?.json?.access_token ||\n  row?.json?.api_key ||\n  row?.json?.key;\n\nif (!rapidapiKey) {\n  throw new Error('Clé RapidAPI introuvable.');\n}\n\nconst key = String(rapidapiKey).replace(/[\\r\\n\\t]/g, '').trim();\n\nreturn [\n  {\n    json: {\n      rapidapi_key: key,\n      query: 'impression 3D France'\n    }\n  },\n  {\n    json: {\n      rapidapi_key: key,\n      query: 'CNC France'\n    }\n  },\n  {\n    json: {\n      rapidapi_key: key,\n      query: 'télépilote drone France'\n    }\n  }\n];"
      },
