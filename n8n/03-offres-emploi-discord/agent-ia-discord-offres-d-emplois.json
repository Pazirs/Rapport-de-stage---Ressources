        "jsCode": "const FIVE_DAYS_MS = 5 * 24 * 60 * 60 * 1000;\nconst minTime = Date.now() - FIVE_DAYS_MS;\n\nconst seenLinks = new Set();\nconst selectedByGroup = {\n  DIY: null,\n  DRONE: null,\n};\n\nlet jobs = [];\n\nfor (const item of items) {\n  if (Array.isArray(item.json?.data)) {\n    jobs.push(...item.json.data);\n  } else if (item.json) {\n    jobs.push(item.json);\n  }\n}\n\nfunction normalizeText(value) {\n  return String(value || '')\n    .normalize('NFD')\n    .replace(/[\\u0300-\\u036f]/g, '')\n    .toLowerCase()\n    .trim();\n}\n\nfor (const job of jobs) {\n  const dateStr = job.job_posted_at_datetime_utc || job.job_posted_at;\n  if (!dateStr) continue;\n\n  const t = Date.parse(dateStr);\n  if (Number.isNaN(t) || t < minTime) continue;\n\n  const titreStr = (job.job_title || '').trim();\n  const titre = normalizeText(titreStr);\n\n  if (\n    titre.includes('stage') ||\n    titre.includes('stagiaire') ||\n    titre.includes('intern') ||\n    titre.includes('alternance') ||\n    titre.includes('apprenti') ||\n    titre.includes('apprentissage')\n  ) continue;\n\n  const entreprise = (job.employer_name || '').trim();\n  const localisation = [job.job_city, job.job_country].filter(Boolean).join(', ');\n  const lien = job.job_apply_link || job.job_apply_url || job.job_google_link || '';\n  const desc = job.job_description || '';\n\n  if (!titreStr || !lien || seenLinks.has(lien)) continue;\n  seenLinks.add(lien);\n\n  const txt = normalizeText(`${titreStr} ${desc}`);\n\n  const isDrone =\n    txt.includes('drone') ||\n    txt.includes('telepilote') ||\n    txt.includes('pilote drone') ||\n    txt.includes('pilotage drone') ||\n    txt.includes('uas') ||\n    txt.includes('uav') ||\n    txt.includes('aeronef sans equipage') ||\n    txt.includes('aeronefs sans equipage') ||\n    txt.includes('photogrammetrie par drone') ||\n    txt.includes('inspection par drone');\n\n  const isCnc =\n    txt.includes('cnc') ||\n    txt.includes('fraisage') ||\n    txt.includes('usinage') ||\n    txt.includes('decoupe laser') ||\n    txt.includes('gravure laser') ||\n    txt.includes('milling');\n\n  const is3D =\n    txt.includes('impression 3d') ||\n    txt.includes('fabrication additive') ||\n    txt.includes('additive manufacturing') ||\n    txt.includes('modelisation 3d') ||\n    txt.includes('3d printing');\n\n  let domaine = '';\n\n  if (isDrone) domaine = 'DRONE';\n  else if (isCnc) domaine = 'CNC';\n  else if (is3D) domaine = '3D';\n\n  if (!domaine) continue;\n\n  const group = domaine === 'DRONE' ? 'DRONE' : 'DIY';\n\n  if (selectedByGroup[group]) continue;\n\n  const texteDiscord =\n`🎯 ${titreStr}\n📍 Localisation : ${localisation || 'Non précisée'}\n🏢 Entreprise : ${entreprise || 'Non précisée'}\n\n🔗 Voir l’offre complète et postuler : ${lien}`;\n\n  selectedByGroup[group] = {\n    json: {\n      type: 'emploi',\n      source: 'JSearch',\n      titre: titreStr,\n      entreprise,\n      localisation,\n      lien,\n      date_publication: dateStr,\n      domaine,\n      brut_source: JSON.stringify(job).slice(0, 5000),\n      texte_offre_discord: texteDiscord,\n      deja_publie: false,\n    },\n  };\n\n  if (selectedByGroup.DIY && selectedByGroup.DRONE) break;\n}\n\nreturn Object.values(selectedByGroup).filter(Boolean);"
