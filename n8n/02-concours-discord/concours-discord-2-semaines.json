        "mode": "runOnceForEachItem",
        "jsCode": "// n8n Code node (JavaScript)\n// Mode: \"Run Once for Each Item\"\n\nconst item = $json;\n\nconst objectif = (item.Objectif || \"\").trim();\nlet contenu = (item.contenu || \"\").trim();\n\n// IDs des salons (mets les bons IDs)\nconst TRAVAUX_CONCOURS_CHANNEL_ID = \"000000000000000001\";\nconst GENERAL_CHANNEL_ID = \"000000000000000002\"; // TODO: remplace par l'ID du salon #général\n\nconst travauxConcoursMention = `<#${TRAVAUX_CONCOURS_CHANNEL_ID}>`;\nconst generalMention = `<#${GENERAL_CHANNEL_ID}>`;\n\n// Remplace \"#général\" par un mention cliquable (gère plusieurs variantes)\ncontenu = contenu\n  .replaceAll(\"#général\", generalMention)\n  .replaceAll(\"#general\", generalMention)\n  .replaceAll(\"#Général\", generalMention)\n  .replaceAll(\"#General\", generalMention);\n\nconst message =\n`⚡ CONCOURS DE LA SEMAINE ⚡\n\nSalut à tous,\n\nVoici le défi de cette semaine. Amusez vous bien, et soyez créatifs 😄\nVous pouvez envoyer vos travaux dans ce canal ${travauxConcoursMention}.\n\n🎯 Objectif :\n${objectif}\n\n${contenu}\n`;\n\nreturn { message };\n"
      },
