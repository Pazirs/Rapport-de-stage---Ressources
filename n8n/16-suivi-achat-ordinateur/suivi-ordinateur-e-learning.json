      "parameters": {
        "jsCode": "// On récupère tous les items (tu n'en as qu'un ici)\nconst items = $input.all();\n\nif (items.length === 0) {\n\treturn [];\n}\n\n// On prend le premier item\nconst src = items[0].json;\n\n// Date de départ = \"Premiere partie\" (ISO)\nconst startStr = src[\"Premiere partie\"]; // ex: \"2025-12-16T16:49:00.000Z\"\n\nif (!startStr) {\n\tthrow new Error('Champ \"Premiere partie\" manquant');\n}\n\nconst start = new Date(startStr);\nif (isNaN(start.getTime())) {\n\tthrow new Error('Date invalide dans \"Premiere partie\": ' + startStr);\n}\n\nconst day = 24 * 60 * 60 * 1000;\n\n// Calculs\nconst d7 = new Date(start.getTime() - 49 * day).toISOString(); // 7 semaines\nconst d5 = new Date(start.getTime() - 35 * day).toISOString(); // 5 semaines\nconst d4 = new Date(start.getTime() - 28 * day).toISOString(); // 4 semaines\nconst d3 = new Date(start.getTime() - 21 * day).toISOString(); // 3 semaines\nconst d1 = new Date(start.getTime() - 7  * day).toISOString(); // 1 semaine\n\n// On renvoie UN SEUL item avec 5 champs\nreturn [\n\t{\n\t\tjson: {\n\t\t\tid: src.id || src[\"id\"],\n\t\t\t\"7_semaines_avant_debut\": d7,\n\t\t\t\"5_semaines_avant_debut\": d5,\n\t\t\t\"4_semaines_avant_debut\": d4,\n\t\t\t\"3_semaines_avant_debut\": d3,\n\t\t\t\"1_semaine_avant_debut\": d1\n\t\t}\n\t}\n];\n"
      },
